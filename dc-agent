#!/usr/bin/env bash
# usage: dc-agent [agent] [agent args...]   (run from anywhere inside the project)
set -euo pipefail

# configuration file path
# The configuration is a TOML file with a single key/value pair named "default_agent".
# The "default_agent" value is the agent name/TUI command name.
config_file="$HOME/.config/herdr-devcontainer-agent-opener/config.toml"

# Print an error message to stderr and abort the script with exit status 1.
die() {
  echo "dc-agent: $*" >&2
  exit 1
}

# Print the value of default_agent from the config file.
# Prints an empty string if the file is missing or the key is not set.
read_default_agent() {
  [[ -f "$config_file" ]] || return 0

  sed -nE 's/^[[:space:]]*default_agent[[:space:]]*=[[:space:]]*"([^"]*)".*/\1/p' "$config_file" | head -n 1
}

# Print the nearest directory, starting at the current one and walking up to /,
# that holds a devcontainer config. Aborts if there is none.
find_workspace_folder() {
  local dir="$PWD"
  while true; do
    if [[ -f "$dir/.devcontainer/devcontainer.json" || -f "$dir/.devcontainer.json" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [[ "$dir" != "/" ]] || die "no devcontainer found in $PWD or any parent directory"
    dir="$(dirname "$dir")"
  done
}

default_agent="$(read_default_agent)"
agent="${1:-$default_agent}"; shift || true
[[ -n "$agent" ]] || die "no agent specified and no default_agent found in $config_file"
workspace="$(find_workspace_folder)"
devcontainer up --docker-path podman --workspace-folder "$workspace" >/dev/null
HERDR_AGENT="$agent" exec devcontainer exec --docker-path podman \
  --workspace-folder "$workspace" "$agent" "$@"
