#!/usr/bin/env bash
# usage: open-agent-in-devcontainer [agent] [agent args...]   (run from anywhere inside the project)
set -euo pipefail

# configuration file path
# The configuration is a TOML file with these optional string keys:
#   default_agent - the agent name/TUI command name used when none is given
#   docker_path   - the container CLI passed to devcontainer as --docker-path
#                   (a leading ~/ is expanded to $HOME)
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/herdr-devcontainer-agent-opener/config.toml"

main() {
  local default_agent agent workspace docker_args up_output

  command -v devcontainer >/dev/null || die "devcontainer CLI not found in PATH"

  # read agent
  default_agent="$(read_config_value default_agent)"
  agent="${1:-$default_agent}"; shift || true
  [[ -n "$agent" ]] || die "no agent specified and no default_agent found in $config_file"

  # read workspace
  workspace="$(find_workspace_folder)"

  # read docker command path
  set_docker_args

  # start the devcontainer and run the agent within it
  # (the CLI reports errors as JSON on stdout, so show its output on failure)
  up_output="$(devcontainer up ${docker_args[@]+"${docker_args[@]}"} --workspace-folder "$workspace")" ||
    { printf '%s\n' "$up_output" >&2; die "devcontainer up failed"; }
  HERDR_AGENT="$agent" exec devcontainer exec ${docker_args[@]+"${docker_args[@]}"} \
    --workspace-folder "$workspace" "$agent" "$@"
}

# Print an error message to stderr and abort the script with exit status 1.
die() {
  echo "open-agent-in-devcontainer: $*" >&2
  exit 1
}

# Print the string value of the given top-level key from the config file.
# Values may be double- or single-quoted. Parsing stops at the first [table]
# header. Prints an empty string if the file is missing or the key is not set.
read_config_value() {
  local key="$1"
  [[ -f "$config_file" ]] || return 0

  sed -nE "/^[[:space:]]*\[/q; s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*(\"([^\"]*)\"|'([^']*)').*/\\2\\3/p" "$config_file" | head -n 1
}

# Print the nearest directory, starting at the current one and walking up to /,
# that holds a devcontainer config. Aborts if there is none.
find_workspace_folder() {
  local dir="$PWD"
  while true; do
    if [[ -f "$dir/.devcontainer/devcontainer.json" || -f "$dir/.devcontainer.json" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [[ "$dir" != "/" ]] || die "no devcontainer found in $PWD or any parent directory"
    dir="$(dirname "$dir")"
  done
}

# Set the caller's docker_args array (dynamic scoping) to the devcontainer CLI's
# --docker-path option, or to an empty array when docker_path is not set in the
# config file.
set_docker_args() {
  local docker_path
  docker_path="$(read_config_value docker_path)"
  docker_path="${docker_path/#\~\//$HOME/}"

  docker_args=()
  [[ -z "$docker_path" ]] || docker_args=(--docker-path "$docker_path")
}

main "$@"
